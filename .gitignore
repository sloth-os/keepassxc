# ninja intermediates — rebuilt by scripts/build.sh; the publishable
# artifacts land in web/wasm/ and ARE committed so a clone can serve the
# site without the (large) toolchain.
/build-wasm/

# local playwright-core install for the browser test (see the header of
# scripts/test-browser.mjs; CI installs it with --no-save instead). Keep the
# npm droppings out — deploy.sh commits with `git add -A`.
node_modules/
package-lock.json

# editor / OS noise
*.swp
.DS_Store
